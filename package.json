{
  "name": "afbiz-autopilot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Lightweight WhatsApp business assistant with a self-improving agent",
  "scripts": {
    "smoke": "tsx scripts/smoke.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "tsx watch --env-file-if-exists=.env agent/index.ts",
    "start": "tsx --env-file-if-exists=.env agent/index.ts",
    "db:setup": "tsx --env-file-if-exists=.env scripts/db-setup.ts",
    "failures": "tsx --env-file-if-exists=.env scripts/failures.ts",
    "improve": "tsx --env-file-if-exists=.env scripts/improve.ts",
    "approve": "tsx --env-file-if-exists=.env scripts/approve.ts",
    "rollback": "tsx --env-file-if-exists=.env scripts/rollback.ts",
    "traffic": "tsx --env-file-if-exists=.env scripts/signal-traffic.ts"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^2.0.13",
    "@hono/node-server": "^2.1.5",
    "@libsql/client": "^0.18.0",
    "@voltagent/core": "^2.11.0",
    "@voltagent/libsql": "^2.1.2",
    "@voltagent/server-hono": "^2.0.14",
    "ai": "^6.0.0",
    "hono": "^4.13.16",
    "postgres": "^3.4.5",
    "posthog-node": "^5.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.8.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=20"
  }
}
