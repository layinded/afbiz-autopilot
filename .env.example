# AFBiz Autopilot - environment template (Phase 1 scaffold)
# Copy to .env and fill in. NEVER commit .env. Placeholders only - no real credentials belong here.

# --- LLM (any OpenAI-compatible endpoint; proven pattern from reference repos) ---
MODEL_API_KEY=                 # your key; set in .env or shell, never committed
MODEL_BASE_URL=https://ollama.com/v1
MODEL_NAME=gpt-oss:20b

# --- PostgreSQL (isolated local instance; NEVER point at production) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/afbiz_autopilot

# --- WhatsApp Cloud API (Phase 2; offline until WHATSAPP_ENABLED=1 and all creds set) ---
WHATSAPP_ENABLED=0
WHATSAPP_VERIFY_TOKEN=replace-me
WHATSAPP_APP_SECRET=replace-me
WHATSAPP_ACCESS_TOKEN=replace-me
WHATSAPP_PHONE_NUMBER_ID=replace-me
WHATSAPP_GRAPH_VERSION=v23.0

# --- PostHog (Phase 3) ---
POSTHOG_PUBLIC_KEY=phc_replace_me
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_SECRET_KEY=phs_replace_me   # enables local feature-flag evaluation

# --- Server ---
PORT=3141
